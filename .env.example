# Copiá este archivo a .env y completá los valores.
DATABASE_URL=postgres://turnos:turnos@localhost:5432/turnos
# URL pública de la app (se usa para armar los links de invitación).
APP_URL=http://localhost:3000

# --- Recordatorios (paso 4) ---
# Email por SMTP (Resend, Brevo, Gmail, el del hosting…). Sin SMTP_HOST los emails solo se simulan en consola.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Turnos <no-reply@tu-dominio.com>"
# Notificaciones push: generá las claves con `npm run vapid`. Sin ellas, las notificaciones quedan deshabilitadas.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contacto@tu-dominio.com
# Clave (mínimo 16 caracteres) para que el programador llame a /api/cron/reminders.
CRON_SECRET=
